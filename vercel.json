{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/market-tonight",
      "destination": "/index.html"
    },
    {
      "source": "/market-tonight/",
      "destination": "/index.html"
    },
    {
      "source": "/market-tonight/:page(festival|map)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/market-tonight/:page(festival|map)/",
      "destination": "/:page/index.html"
    },
    {
      "source": "/market-tonight/:path*",
      "destination": "/:path*"
    }
  ],
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "docs"
}
