{
  "name": "figma-make-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --port 3000 --hostname 127.0.0.1",
    "format": "oxfmt",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "build:deploy": "pnpm build && node scripts/prepare-standalone.mjs",
    "start:deploy": "node scripts/start-production.mjs",
    "build:pages": "node scripts/export-pages.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@payloadcms/figma": "1.0.0-beta.1",
    "@payloadcms/next": "4.0.0-beta.4",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.4",
    "@payloadcms/plugin-mcp": "4.0.0-beta.4",
    "@payloadcms/richtext-lexical": "4.0.0-beta.4",
    "@payloadcms/translations": "4.0.0-beta.4",
    "@payloadcms/ui": "4.0.0-beta.4",
    "graphql": "^16.8.1",
    "html-react-parser": "^5.2.10",
    "monaco-editor": "0.55.1",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "payload": "4.0.0-beta.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.34.3"
}
